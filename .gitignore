# Local research checkpoint data; regenerate from scripts/research_inventory.py
research-data/

# Python bytecode caches
__pycache__/
*.py[cod]

# Bulk corpus sources (multi-GB) — kept on disk, not in version control
old/
repo/

# Corpus outputs (database, manifests, scraped knowledge) — regenerable
data/

# Pipeline logs
logs/

# Dependencies and build output
node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# Secrets
.env
.env.local
.env*.local
.env.deploy
.env.*.deploy
**/.env
**/.env.*.deploy
.env.production*
.env.*.production*
# Key/cert material (Apple/Google service keys, TLS, etc.) — never commit.
*.p8
*.p12
*.pem

# Vercel CLI link state
.vercel

# Downloaded service credentials (providers offer these as a file; never commit)
*credentials*.txt
*-credentials*

# Local credential notes and provider hand-off files
pg_service.conf
.pg_service.conf
*.pg_service.conf
*token*.txt
*secret*.txt
*password*.txt
vercel-token.txt
tigerdata.txt
.vercel
.env.deploy

# Provider chat/console exports that embed API keys (Alchemy, Reown/WalletConnect,
# Etherscan). These are pasted by hand into the repo root, so match both the exact
# names seen and the loose patterns, or the next one gets committed by accident.
Alchemy.txt
alchemy*.txt
reown-info.txt
reown*.txt
Etherscan.txt
tigerdata*.txt
*apikey*.txt
*api-key*.txt

# Signals provider hand-off (AltFins, TAAPI.IO, Finnhub, CoinMarketCap, WunderTrading, …).
# It carries live API keys, so it stays out of version control; the sanitised knowledge
# base it produced lives in `docs/signals/`.
signals/

# Coinbase CDP API key downloads (id + secret) and wallet-secret files.
cdp_api_key.json
cdp_api_key*.json
cdp*wallet*secret*.json
cdp-wallet-secret*
coinbase*credentials*
# …but not the credential-audit *test*, whose name matches the pattern above by accident.
!apps/web/tests/coinbase-credentials.test.ts
# Coinbase CDP docs/console export. It carries live API keys and a webhook signing
# secret in its header, so it stays out of version control; the sanitised, split
# knowledge base it produces lives in `coinbase/` (regenerate with
# `python3 scripts/coinbase_extract.py`).
coinbase-api-and-docs.txt
coinbase*docs*.txt
coinbase*api*docs*

