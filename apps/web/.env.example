# Copy to .env and fill in. NEVER commit real secrets.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-32-byte-random-string"

# Everything below is OPTIONAL. The app runs fully with the simulated provider.
# Market data (real, public, no key required): CoinGecko public API
MARKET_PROVIDER="auto"        # auto | coingecko | simulated
# News: comma-separated public RSS feed URLs.
# Leave empty to use the built-in real public defaults
# (Cointelegraph, Investing.com, BBC Business). News is never fabricated.
NEWS_FEEDS=""
# Simulated withdrawal platform fee, in basis points (100 = 1%)
WITHDRAW_FEE_BPS="100"
MIN_TRADE_USD="20"
