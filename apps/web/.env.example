# Copy to .env and fill in. NEVER commit real secrets.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-32-byte-random-string"

# --- Provider key pool (admin-managed API keys) ---
# Encrypts keys added from /admin/credentials at rest (AES-256-GCM). Generate with
# `openssl rand -base64 32`. Unset ⇒ the key pool is disabled (fail closed) and only
# env-var keys are used. Changing it makes existing stored keys undecryptable, so
# rotate it deliberately (see docs/KEY_ROTATION.md). Server-only secret.
CREDENTIAL_ENCRYPTION_KEY=""

# --- Wallet sign-in (Phase 18) ---
# Public WalletConnect / Reown Cloud project id. NOT a secret. Leave empty to run
# with injected browser wallets only (the WalletConnect QR needs a real id).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Optional: pins the SIWE domain (anti-phishing). Defaults to the request host.
SIWE_DOMAIN=""
# Comma-separated wallet addresses granted the ADMIN role at sign-in.
ADMIN_WALLET_ADDRESSES=""
# Comma-separated wallet addresses that are the **site owner**: always ADMIN, plus the
# three owner-only surfaces — a practice-network (SANDBOX) sign-in, the owner card on
# /admin, and the practice-funds credit. Empty means there is no owner, so every
# owner-only path is unreachable (the safe default).
OWNER_WALLET_ADDRESSES=""
# Kill switch for real (mainnet) execution. Real execution is ON by default: a
# mainnet session runs custody-signed swaps once custody is configured below. Set
# this to "0" to refuse every mainnet money action on this deployment (fail closed).
MAINNET_EXECUTION_ENABLED=""
# --- Custodial hot-wallet custody (Phase 18, PHASE18-004) ---
# The operational key lives with the provider (a KMS/HSM, or a provider-hosted
# wallet) — NEVER put a private key, seed phrase or signing secret here. These name
# *where* the key lives; the app only ever holds a reference and gets a signature.
# Backend: "coinbase-cdp" (Coinbase CDP Server Wallets, free tier). Left empty,
# custody is unavailable and no real funds can move.
CUSTODY_PROVIDER=""              # e.g. coinbase-cdp
CUSTODY_KEY_ID=""                # provider-side key/account name (not a secret)
# Coinbase CDP API credentials — only needed when CUSTODY_PROVIDER="coinbase-cdp".
# These are API credentials; the wallet key stays inside Coinbase.
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""
CDP_WALLET_SECRET=""
# Spend limits enforced at the custody boundary before any real key is used.
# An amount over a cap is refused, never trimmed.
CUSTODY_MAX_PER_TX_USD="1000"
CUSTODY_DAILY_LIMIT_USD="5000"

# --- Compliance screening (optional) ---
# Default (empty) = inert no-op: no KYC/AML, sanctions or jurisdiction screening runs,
# and the app states that plainly instead of implying coverage.
# `sanctions-list` is a real, credential-free backend: it screens wallet addresses
# against the published OFAC SDN list. Selecting it means real movements are refused on
# a hit — and while the list is unreachable (fail closed). See docs/NETWORK_BOUNDARY.md.
COMPLIANCE_PROVIDER=""
# Optional: fetch the list from a mirror or a pinned snapshot instead of OFAC directly.
COMPLIANCE_SANCTIONS_LIST_URL=""
# Optional: cache window for the parsed list, in ms (default 21600000 = 6 hours).
COMPLIANCE_SANCTIONS_CACHE_MS=""

# --- Coinbase webhooks (Phase 19, PHASE19-006) ---
# Secret for the Coinbase CDP webhook subscription, used to verify the
# X-Hook0-Signature header on every delivery. Leave empty and the receiver at
# /api/webhooks/coinbase is disabled (it accepts nothing) — fail closed.
COINBASE_WEBHOOK_SECRET=""

# --- Finnhub webhooks ---
# Shared secret Finnhub sends in the X-Finnhub-Secret header on every delivery.
# Leave empty and the receiver at /api/webhooks/finnhub is disabled (it accepts
# nothing) — fail closed. The receiver only verifies and records deliveries; it
# applies no balance change.
FINNHUB_WEBHOOK_SECRET=""

# --- Scheduled desk sync ---
# Vercel Cron (see vercel.json) calls /api/cron/sync-desk with
# `Authorization: Bearer <CRON_SECRET>`. Unset ⇒ the endpoint is disabled and
# returns 503, accepting nothing — fail closed. Set the same value in the
# Vercel project so the scheduled invocation is authorised.
CRON_SECRET=""

# --- Signals (read-only inputs; see docs/signals/) ---
# AltFins signal feed. Its presence enables the adapter; empty means that adapter
# is inert. The signal layer is never fully inert: keyless alternates below always run.
ALTFINS_API_KEY=""
# FreeCryptoAPI key (keyed alternate market source). Empty means the adapter is inert.
FREECRYPTOAPI_API_KEY=""
# TAAPI.IO key (technical indicators: RSI/MACD, neutral context). Empty means inert.
TAAPI_API_KEY=""
# CoinMarketCap key (optional). Absent, the keyless public API is used instead.
COINMARKETCAP_API_KEY=""
# A 24h move of at least this percent (default 5) is recorded as a NEUTRAL market-move
# signal by the keyless/derived providers, so the desk keeps market context when a keyed
# signal API is down. Neutral events raise the desk to "elevated" only; they can never
# make it risk-off, so trading never stops for want of a signal feed.
SIGNAL_MOVE_THRESHOLD_PCT="5"
# Finnhub API key (equities/forex/crypto quotes + news). Not required by the
# webhook receiver above, which uses FINNHUB_WEBHOOK_SECRET instead.
FINNHUB_API_KEY=""

# --- WunderTrading execution API (CAN MOVE FUNDS) ---
# HMAC-SHA256 signing material for the venue-order executor. Server-only: never
# in a NEXT_PUBLIC_* var, the client bundle, or logs. Either key empty ⇒ the
# venue executor refuses (fail closed, like custody). Rotate if ever exposed.
WUNDERTRADING_API_KEY=""
WUNDERTRADING_SECRET_KEY=""
# Real-money caps for a venue order (USD). An order over either cap is refused,
# never trimmed. Enforced before anything is signed (config.venue.spendLimits).
VENUE_MAX_PER_TX_USD="1000"
VENUE_DAILY_LIMIT_USD="5000"

# Per-chain wallet RPC endpoints (optional; a hosted provider such as Alchemy).
# NEXT_PUBLIC_* because wagmi runs in the browser, so these are PUBLIC: the URL
# (and any key in it) ships to every visitor. Restrict the key at the provider
# (origin allowlist / rate limits) instead of treating it as a secret.
# Unset ⇒ viem's default public RPC for that chain.
NEXT_PUBLIC_WALLET_RPC_URL_ETHEREUM=""
NEXT_PUBLIC_WALLET_RPC_URL_SEPOLIA=""
NEXT_PUBLIC_WALLET_RPC_URL_BASE=""
NEXT_PUBLIC_WALLET_RPC_URL_BASE_SEPOLIA=""
NEXT_PUBLIC_WALLET_RPC_URL_ARBITRUM=""
NEXT_PUBLIC_WALLET_RPC_URL_ARBITRUM_SEPOLIA=""

# Everything below is OPTIONAL. The app runs fully on the offline fallback provider.
# Market data (real, public, no key required): CoinGecko public API
MARKET_PROVIDER="auto"        # auto | coingecko | finnhub | offline
# `auto` routes by asset class: crypto -> CoinGecko, equities -> Finnhub (needs
# FINNHUB_API_KEY), everything else -> the labelled offline generator.
# News: comma-separated public RSS feed URLs.
# Leave empty to use the built-in real public defaults
# (Cointelegraph, Investing.com, BBC Business). News is never fabricated.
NEWS_FEEDS=""
# Withdrawal platform fee, in basis points (100 = 1%)
WITHDRAW_FEE_BPS="100"
MIN_TRADE_USD="20"
# Hard per-deposit spend cap (USD). A larger deposit is refused, never trimmed.
DEPOSIT_CAP_USD="10000"
# How long a user has to dispute a DECLINED withdrawal request, in business days
# (Mon-Fri, UTC; no public-holiday calendar). The user argues the case in the support
# thread the decline opens; an admin then resolves it (clear, or confirm misuse, which
# bans the account and freezes the balance - it never transfers it).
DISPUTE_WINDOW_BUSINESS_DAYS="3"
