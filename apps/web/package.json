{
  "name": "veylora-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/select-provider.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/market.test.ts tests/owner.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:docs": "vitest run tests/docs.test.ts",
    "test:e2e": "playwright test",
    "test:owner-gating": "playwright test tests/e2e/owner-gating.spec.ts",
    "smoke:coinbase": "vitest run tests/coinbase.live.test.ts",
    "check:coinbase-credentials": "tsx scripts/coinbase-credentials.ts",
    "check:provider-keys": "tsx scripts/provider-keys.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify:deploy": "npm run build && npm test",
    "test:ui-audit": "playwright test tests/e2e/ui-audit.spec.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.58.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "^6.7.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@spruceid/siwe-parser": "^3.0.0",
    "@tanstack/react-query": "^5.104.1",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.57.4",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "ws": "^8.20.1",
    "decode-uri-component": "^0.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
